# VEYROX Backend Environment Variables (Server-Side Only)
PORT=8787
HOST=0.0.0.0

# Set GEMINI_API_KEY on your server to enable live Gemini responses.
# Leave blank to run the backend in clearly labeled DEMO MODE.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed frontend origins (use your production HTTPS domain when deployed)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Set AUTH_REQUIRED=true and AUTH_BEARER_TOKEN in production if gating API access
AUTH_REQUIRED=false
AUTH_BEARER_TOKEN=

# Official VEYROX Discord Invitation
VEYROX_DISCORD_URL=https://discord.gg/WTctmpDXVc
